:root {
    --teal-primary: #0d9488;
    --teal-light: #14b8a6;
    --teal-glow: rgba(13, 148, 136, 0.4);
    --bg-dark: #090d16;
    --card-bg: #131b2e;
    --card-border: rgba(255, 255, 255, 0.08);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent-red: #ef4444;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    min-height: 100vh;
}

/* Navbar Header */
.navbar {
    background: rgba(19, 27, 46, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--card-border);
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-logo {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: 1px;
}

.brand-logo span {
    color: var(--teal-light);
}

.nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    margin: 0 1rem;
    font-size: 0.95rem;
    font-weight: 500;
}

.nav-links a:hover {
    color: var(--text-main);
}

.nav-cart-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    color: var(--text-main);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    cursor: pointer;
}

/* Layout */
.main-wrapper {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

.product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

/* Left Showcase Panel */
.preview-box {
    background: radial-gradient(circle at center, #1e293b 0%, var(--card-bg) 100%);
    border-radius: 24px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--card-border);
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.badge-tag {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: rgba(20, 184, 166, 0.15);
    color: var(--teal-light);
    border: 1px solid rgba(20, 184, 166, 0.3);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Realistic 3D Wristband Ring */
.wristband-3d-wrapper {
    margin: 2rem 0;
}

.wristband-strap {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    border: 24px solid var(--teal-primary);
    box-shadow: 
        0 0 35px var(--teal-glow),
        inset 0 4px 8px rgba(255, 255, 255, 0.3),
        inset 0 -6px 12px rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
}

.band-core {
    width: 120px;
    height: 120px;
    background: linear-gradient(145deg, #111, #1a1a1a);
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.6);
}

.glass-reflection {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 50%);
    pointer-events: none;
}

.screen-content {
    text-align: center;
    z-index: 2;
}

.status-bar {
    font-size: 0.65rem;
    color: var(--teal-light);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.signal-dot {
    width: 6px;
    height: 6px;
    background: var(--teal-light);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--teal-light);
}

.main-stat {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0.2rem 0;
}

.main-stat span {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.sub-stat {
    font-size: 0.65rem;
    color: var(--text-muted);
}

/* Screen Mode Toggles */
.screen-modes {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.mode-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: 15px;
    font-size: 0.8rem;
    cursor: pointer;
}

.mode-btn.active, .mode-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-main);
}

.selected-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.3);
    padding: 0.5rem 1rem;
    border-radius: 20px;
}

/* Right Panel Styles */
.product-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.rating-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.stars {
    color: #f59e0b;
    font-size: 0.9rem;
}

.rating-text {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.product-panel h1 {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
}

.subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.5;
}

.price-row {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.current-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-main);
}

.old-price {
    font-size: 1.1rem;
    color: var(--text-muted);
    text-decoration: line-through;
}

.save-badge {
    background: rgba(239, 68, 68, 0.15);
    color: var(--accent-red);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
}

.option-group {
    border-top: 1px solid var(--card-border);
    padding-top: 1.2rem;
}

.option-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
}

.option-value {
    color: var(--teal-light);
    font-weight: 600;
}

/* Swatches */
.swatches {
    display: flex;
    gap: 1rem;
}

.swatch {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--swatch-color);
    cursor: pointer;
    border: 3px solid transparent;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.swatch.active {
    border-color: var(--text-main);
    transform: scale(1.1);
}

/* Size Buttons */
.sizes {
    display: flex;
    gap: 1rem;
}

.size-btn {
    flex: 1;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--card-border);
    padding: 0.8rem;
    border-radius: 12px;
    cursor: pointer;
    text-align: center;
}

.size-btn strong {
    display: block;
    font-size: 0.9rem;
}

.size-btn span {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.size-btn.active {
    border-color: var(--teal-light);
    background: rgba(13, 148, 136, 0.15);
}

/* Order Button */
.order-btn {
    background: linear-gradient(135deg, var(--teal-primary), var(--teal-light));
    color: #ffffff;
    border: none;
    padding: 1.1rem 2rem;
    border-radius: 30px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 8px 25px var(--teal-glow);
}

.order-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(13, 148, 136, 0.6);
}

.guarantee-row {
    display: flex;
    justify-content: space-around;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid var(--card-border);
    padding-top: 1rem;
}

@media (max-width: 850px) {
    .product-container {
        grid-template-columns: 1fr;
    }
}
